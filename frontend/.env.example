# Optional. Leave API base empty in development (Vite proxies /api to http://localhost:8080).
# For a production build served from another host, set the full backend URL, e.g. https://gym.example.com
VITE_API_BASE_URL=

# Shows "Use demo admin / staff" buttons on the login page. Set to false for real deployments.
VITE_SHOW_DEMO_LOGINS=true
