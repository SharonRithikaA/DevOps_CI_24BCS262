# Copy this file to ".env" (same folder) and fill in your own values.
# .env is git-ignored. Do NOT commit real secrets.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_db
DB_USERNAME=gym_user
DB_PASSWORD=change_me_db_password

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_of_32_chars_or_more
JWT_EXPIRY_HOURS=8

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# Demo data + demo logins (admin / staff). Set SEED_ENABLED=false for a clean database.
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=Admin@123
SEED_STAFF_PASSWORD=Staff@123
